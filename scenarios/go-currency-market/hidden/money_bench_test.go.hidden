package money

import (
	"reflect"
	"testing"
)

func TestFormatMinorUnits(t *testing.T) {
	cases := []struct {
		amt  int64
		cur  string
		want string
	}{
		{12345, "INR", "123.45"},
		{12345, "inr", "123.45"},
		{500, "JPY", "500"},
		{0, "KRW", "0"},
		{12345, "KWD", "12.345"},
		{1, "BHD", "0.001"},
		{5, "USD", "0.05"},
		{-70, "USD", "-0.70"},
		{-1, "omr", "-0.001"},
		{0, "EUR", "0.00"},
		{100000000, "VND", "100000000"},
	}
	for _, c := range cases {
		if got := FormatMinorUnits(c.amt, c.cur); got != c.want {
			t.Errorf("FormatMinorUnits(%d,%q)=%q want %q", c.amt, c.cur, got, c.want)
		}
	}
}

func TestCountriesForCurrency(t *testing.T) {
	cases := []struct {
		cur  string
		want []string
	}{
		{"AED", []string{"AE"}},
		{"sar", []string{"SA"}},
		{"EUR", []string{"DE", "FR", "IT", "ES", "NL"}},
		{"XYZ", []string{}},
	}
	for _, c := range cases {
		got := CountriesForCurrency(c.cur)
		if got == nil {
			t.Fatalf("CountriesForCurrency(%q) returned nil, want non-nil", c.cur)
		}
		if !reflect.DeepEqual(got, c.want) {
			t.Errorf("CountriesForCurrency(%q)=%v want %v", c.cur, got, c.want)
		}
	}
}
