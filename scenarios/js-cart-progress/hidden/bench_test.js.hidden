const assert = require('assert');
const { freeShippingState, formatMoney } = require('./cart-progress');

const cases = [
  [freeShippingState(0, 100000), { unlocked: false, percent: 0, remainingCents: 100000, disabled: false }],
  [freeShippingState(99999, 100000), { unlocked: false, percent: 99, remainingCents: 1, disabled: false }],
  [freeShippingState(100000, 100000), { unlocked: true, percent: 100, remainingCents: 0, disabled: false }],
  [freeShippingState(250000, 100000), { unlocked: true, percent: 100, remainingCents: 0, disabled: false }],
  [freeShippingState(500, 0), { unlocked: false, percent: 0, remainingCents: 0, disabled: true }],
  [freeShippingState(500, -100), { unlocked: false, percent: 0, remainingCents: 0, disabled: true }],
  [freeShippingState(500, NaN), { unlocked: false, percent: 0, remainingCents: 0, disabled: true }],
];
for (const [got, want] of cases) {
  assert.deepStrictEqual(got, want, JSON.stringify({ got, want }));
}

assert.strictEqual(formatMoney(123450, '₹'), '₹1,234.50');
assert.strictEqual(formatMoney(5, '$'), '$0.05');
assert.strictEqual(formatMoney(0, '$'), '$0.00');
assert.strictEqual(formatMoney(-70, '₹'), '-₹0.70');
assert.strictEqual(formatMoney(100000000, '$'), '$1,000,000.00');
assert.strictEqual(formatMoney(NaN, '$'), '$0.00');

console.log('hidden tests passed');
